---
import TopicView from '../../components/architecture/TopicView.astro';
import { architectureRegistry } from '../../data/architecture/catalog';
import Layout from '../../layouts/Layout.astro';
const decisions = architectureRegistry.decisions.filter((item) =>
  /platform\.(cloudflare|infisical|postgresql|compute|infrastructure|mvp-deployment|first-distributed|progressive-placement|automation-full-mesh)|billing/u.test(
    item.id,
  ),
);
---

<Layout
  title="Infrastructure and deployment"
  description="Railway MVP services, managed data, secrets, and the future paid VPS migration path."
  currentPath="/infrastructure/"
  ><div class="content-wrap">
    <TopicView
      eyebrow="Static-first architecture repository"
      title="Infrastructure"
      description="Railway-hosted Core API and worker services across isolated environments, external Neon and R2, Infisical Secret Sync, and the selected portable Dockerfile, with implementation and validation tracked by CI/CD work for Railway and a future paid VPS migration when scale or operational evidence justifies host operations."
      {decisions}
    />
  </div></Layout
>
