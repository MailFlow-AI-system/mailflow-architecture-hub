---
import EntityCard from '../../components/ui/EntityCard.astro';
import PageHeading from '../../components/ui/PageHeading.astro';
import { architectureDiagrams, composeWholeArchitecture } from '../../data/architecture/diagrams';
import Layout from '../../layouts/Layout.astro';

const wholeDiagram = composeWholeArchitecture(architectureDiagrams);
---

<Layout
  title="Architecture explorer"
  description="Connected, phase-aware MailFlow architecture views."
  currentPath="/explorer/"
>
  <div class="content-wrap">
    <PageHeading
      eyebrow={`${architectureDiagrams.length} connected views`}
      title="Visual explorer"
      description="Use the complete canvas for whole-system navigation, then move into focused views for legible detail. Every node and relationship remains linked to stable decisions, services, phases, and trust boundaries."
    />
    <EntityCard
      href="/explorer/whole/"
      eyebrow={`${wholeDiagram.nodes.length} normalized nodes · ${wholeDiagram.edges.length} unique connections`}
      title="Complete architecture canvas"
      summary="Open the full-system workspace to pan and zoom across every canonical service, boundary, provider, data store, and typed connection."
      meta="MVP and complete architecture modes"
    />
    <div class="catalog-grid" data-pagefind-body>
      {
        architectureDiagrams.map((diagram) => (
          <EntityCard
            href={`/explorer/${diagram.id}/`}
            eyebrow={`${diagram.phases.join(' → ')} · ${diagram.nodes.length} nodes`}
            title={diagram.title}
            summary={diagram.purpose}
            meta={diagram.id}
          />
        ))
      }
    </div>
  </div>
</Layout>
