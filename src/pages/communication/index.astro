---
import TopicView from '../../components/architecture/TopicView.astro';
import { architectureRegistry } from '../../data/architecture/catalog';
import Layout from '../../layouts/Layout.astro';
const decisions = architectureRegistry.decisions.filter((item) =>
  /communication|messaging|jobs|publication-contract|runtime-transport|domain-action/u.test(
    item.id,
  ),
);
---

<Layout
  title="Communication and contracts"
  description="Synchronous, asynchronous, durable, and provider boundaries."
  currentPath="/communication/"
  ><div class="content-wrap">
    <TopicView
      eyebrow="Typed boundaries"
      title="Communication"
      description="Shallow REST composition, versioned producer-owned contracts, durable commands, facts, projections, outbox/inbox, retries, and reconciliation."
      {decisions}
    />
  </div></Layout
>
