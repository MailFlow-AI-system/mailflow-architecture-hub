---
import PageHeading from '../../components/ui/PageHeading.astro';
import baselineVersion from '../../data/architecture/baselineVersion.json';
import coverageManifest from '../../../docs/architecture/coverageManifest.json';
import { architectureRegistry } from '../../data/architecture/catalog';
import { architectureDiagrams } from '../../data/architecture/diagrams';
import { coverageWithDiagrams } from '../../data/architecture/traceability';
import Layout from '../../layouts/Layout.astro';

const resolved = architectureRegistry.coverage.filter(
  (item) => item.classification !== 'not_classified',
).length;
const contextOnly = architectureRegistry.coverage.filter(
  (item) => item.classification === 'not_applicable',
).length;
const coveragePercent = ((resolved / architectureRegistry.coverage.length) * 100).toFixed(1);
const statuses = Object.entries(
  Object.groupBy(architectureRegistry.decisions, (item) => item.status),
);
const diagramMappedRecords = coverageWithDiagrams.filter(
  (item) => item.diagramIds.length > 0,
).length;
---

<Layout
  title="Baseline coverage"
  description="Verifiable incorporation and drift status for the architecture baseline."
  currentPath="/coverage/"
>
  <div class="content-wrap" data-pagefind-body>
    <PageHeading
      eyebrow="Automated drift gate"
      title="Baseline coverage"
      description="Every parsed section and structural block has a source digest and a classified projection. A changed baseline produces changed digests before the derived views can be considered current."
    />
    <div class="catalog-grid">
      <article class="record-panel">
        <p class="eyebrow">Coverage</p><h2>{coveragePercent}%</h2><p>
          {resolved} / {architectureRegistry.coverage.length} records resolved; {contextOnly} are explicit
          context-only records.
        </p>
      </article>
      <article class="record-panel">
        <p class="eyebrow">Baseline</p><h2>{baselineVersion.lines} lines</h2><p>
          {baselineVersion.words} words · {baselineVersion.bytes} bytes
        </p>
      </article>
      <article class="record-panel">
        <p class="eyebrow">Catalog</p><h2>{architectureRegistry.decisions.length} decisions</h2><p>
          {architectureRegistry.services.length} services · {architectureRegistry.stacks.length} stacks
          · {architectureRegistry.gates.length} gates · {architectureDiagrams.length} diagrams
        </p>
      </article>
    </div>
    <section class="record-panel">
      <h2>Decision state</h2><ul>
        {
          statuses.map(([status, entries]) => (
            <li>
              <strong>{status.replaceAll('_', ' ')}</strong>: {entries?.length ?? 0}
            </li>
          ))
        }
      </ul>
    </section>
    <section class="record-panel">
      <h2>Diagram traceability</h2><p>
        {diagramMappedRecords} coverage records link through source decisions to one or more focused diagrams.
        Narrative-only and reference blocks remain classified even when they do not belong on a canvas.
      </p>
    </section>
    <section class="record-panel">
      <h2>Manifest review and drift</h2>
      <p>
        {coverageManifest.summary.machineClassified} records are machine-classified and{' '}
        {coverageManifest.summary.humanReviewed} are marked human-reviewed. Classification is not a substitute
        for human approval.
      </p>
      <p>
        Baseline delta from the previous recorded checksum: {coverageManifest.delta.added} added,{
          ' '
        }
        {coverageManifest.delta.changed} changed, {coverageManifest.delta.removed} removed. Previous checksum:
        {coverageManifest.previousBaselineChecksum ?? 'initial snapshot'}.
      </p>
      <p>
        {coverageManifest.delta.unresolvedRecordKeys.length} delta records await review. Manifest checksum:{
          ' '
        }
        <code>{coverageManifest.manifest.checksum}</code>.
      </p>
    </section>
    <section class="record-panel">
      <h2>Current source fingerprint</h2><p><code>{baselineVersion.checksum.value}</code></p><p>
        Source: <code>{baselineVersion.source}</code>. Last recorded: {baselineVersion.lastUpdated}.
      </p>
    </section>
    <section class="record-panel">
      <h2>What the gate detects</h2><ul>
        <li>Unclassified sections or blocks.</li><li>
          Missing pages and broken entity references.
        </li><li>Duplicate or conflicting stable IDs.</li><li>
          Services without stack or ownership.
        </li><li>Gates without reciprocal decisions.</li><li>
          Diagram nodes and edges without source decisions.
        </li><li>Phase contradictions and stale source digests.</li>
      </ul>
    </section>
  </div>
</Layout>
