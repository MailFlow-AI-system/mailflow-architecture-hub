---
import PageHeading from '../../components/ui/PageHeading.astro';
import MarkdownContent from '../../components/ui/MarkdownContent.astro';
import { architectureRegistry, excerptForRange } from '../../data/architecture/catalog';
import { serviceToDiagramIds } from '../../data/architecture/traceability';
import Layout from '../../layouts/Layout.astro';
import type { Service } from '../../domain/architecture';

export function getStaticPaths() {
  return architectureRegistry.services.map((service) => ({
    params: { id: service.id },
    props: { service },
  }));
}
interface Props {
  service: Service;
}
const { service } = Astro.props as Props;
const diagramIds = serviceToDiagramIds.get(service.id) ?? [];
const narrativeRows = [
  ['Stack motivation', service.stackMotivation],
  ['Stack trade-offs', service.stackTradeOffs],
  ['Stack alternatives', service.stackAlternatives],
  ['Extraction triggers', service.extractionTriggers],
  ['Migration triggers', service.migrationTriggers],
  ['Security', service.security],
  ['Authentication', service.authentication],
  ['Authorization', service.authorization],
] as const;
---

<Layout title={service.name} description={service.responsibility} currentPath="/services/">
  <div class="content-wrap" data-pagefind-body>
    <PageHeading
      eyebrow={service.id}
      title={service.name}
      description={service.responsibility}
      breadcrumbs={[{ label: 'Services', href: '/services/' }, { label: service.name }]}
    />
    <div class="record-layout">
      <article>
        <section class="record-panel">
          <h2>Authority and source</h2>{
            service.sourceAnchors.map((source) => (
              <div>
                <>
                  <p>
                    Lines {source.range.startLine}–{source.range.endLine} ·{' '}
                    {source.digest.value.slice(0, 12)}…
                  </p>
                  <MarkdownContent
                    content={excerptForRange(source.range.startLine, source.range.endLine)}
                  />
                </>
              </div>
            ))
          }
        </section>
        <section class="record-panel">
          <h2>Owned data</h2>{
            service.dataOwned.length ? (
              <ul>
                {service.dataOwned.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              <p>Use linked decisions and baseline evidence; no extra ownership was inferred.</p>
            )
          }<h3>Forbidden access</h3>{
            service.dataForbidden.length ? (
              <ul>
                {service.dataForbidden.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            ) : (
              <p>No additional projection beyond linked trust boundaries.</p>
            )
          }
        </section>
        <section class="record-panel">
          <h2>Contracts and processes</h2>
          <h3>API and command contracts</h3>
          {
            service.apiContracts.length ? (
              <ul>
                {service.apiContracts.map((contract) => (
                  <li>
                    <strong>{contract.name}</strong> · {contract.kind.replaceAll('_', ' ')} ·{' '}
                    {contract.direction}
                  </li>
                ))}
              </ul>
            ) : (
              <p>No explicit contract is classified for this service.</p>
            )
          }
          <h3>Events published</h3>
          {
            service.eventsPublished.length ? (
              <ul>
                {service.eventsPublished.map((event) => (
                  <li>{event.name}</li>
                ))}
              </ul>
            ) : (
              <p>No published event is explicitly classified for this service.</p>
            )
          }
          <h3>Events consumed</h3>
          {
            service.eventsConsumed.length ? (
              <ul>
                {service.eventsConsumed.map((event) => (
                  <li>{event.name}</li>
                ))}
              </ul>
            ) : (
              <p>No consumed event is explicitly classified for this service.</p>
            )
          }
          <h3>Dependencies</h3>
          {
            service.dependencies.length ? (
              <ul>
                {service.dependencies.map((dependency) => (
                  <li>
                    <strong>{dependency.target}</strong> · {dependency.phase} ·{' '}
                    {dependency.reason.items.join('; ')}
                  </li>
                ))}
              </ul>
            ) : (
              <p>No dependency is explicitly classified for this service.</p>
            )
          }
          <h3>Process roles</h3>
          {
            service.processRoles.length ? (
              <ul>
                {service.processRoles.map((process) => (
                  <li>
                    <strong>{process.role}</strong> · {process.responsibilities.join('; ')}
                  </li>
                ))}
              </ul>
            ) : (
              <p>No API, worker, or scheduler role is explicitly classified for this service.</p>
            )
          }
        </section>
        <section class="record-panel">
          <h2>Placement and lifecycle</h2>
          <p>
            <strong>{service.placement.status.replaceAll('_', ' ')}</strong> · phases{' '}
            {service.placement.phases.join(', ') || 'not classified'}
          </p>
          <p>Locations: {service.placement.locations.join(', ') || 'not documented'}</p>
          <ul>{service.placement.conditions.map((condition) => <li>{condition}</li>)}</ul>
        </section>
        <section class="record-panel">
          <h2>Decision-backed analysis</h2>
          {
            narrativeRows.map(([label, narrative]) => (
              <section>
                <h3>{label}</h3>
                {narrative.status === 'documented' ? (
                  narrative.items.map((item) => <MarkdownContent content={item} />)
                ) : (
                  <p>{narrative.note}</p>
                )}
              </section>
            ))
          }
        </section>
      </article>
      <aside class="record-aside">
        <dl>
          <dt>Phase</dt><dd>{service.phase}</dd><dt>Owner</dt><dd>
            <strong>{service.owner.id}</strong><p>{service.owner.responsibilities.join('; ')}</p>
          </dd><dt>Stacks</dt><dd>
            <p>{service.stackStatus.replaceAll('_', ' ')}</p>
            <ul class="record-links">
              {
                service.stackIds.map((id) => (
                  <li>
                    <a href={`/stacks/${id}/`}>{id}</a>
                  </li>
                ))
              }
            </ul>
          </dd><dt>Decisions</dt><dd>
            <ul class="record-links">
              {
                service.decisionIds.map((id) => (
                  <li>
                    <a href={`/decisions/${id}/`}>{id}</a>
                  </li>
                ))
              }
            </ul>
          </dd><dt>Diagrams</dt><dd>
            <ul class="record-links">
              {
                diagramIds.map((id) => (
                  <li>
                    <a href={`/explorer/${id}/`}>{id}</a>
                  </li>
                ))
              }
            </ul>
          </dd><dt>Trust boundaries</dt><dd>
            {service.trustBoundaryIds.join(', ') || 'See linked decisions'}
          </dd>
        </dl>
      </aside>
    </div>
  </div>
</Layout>
