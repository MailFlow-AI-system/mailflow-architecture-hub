---
import Breadcrumbs from '../shell/Breadcrumbs.astro';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { eyebrow, title, description, breadcrumbs } = Astro.props;
---

<div class="page-heading">
  {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {description && <p class="page-heading__description">{description}</p>}
</div>

<style>
  .page-heading {
    padding: var(--space-7) 0 var(--space-6);
  }

  .page-heading :global(.breadcrumbs) {
    margin-bottom: var(--space-5);
  }

  .page-heading h1 {
    max-width: 14ch;
    margin: 0;
    color: var(--color-paper-100);
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 6.5rem);
    font-weight: 800;
    letter-spacing: var(--tracking-tight);
    line-height: 0.86;
    text-transform: uppercase;
  }

  .page-heading__description {
    max-width: 42rem;
    margin: var(--space-4) 0 0;
    color: var(--color-paper-300);
    font-size: var(--text-lg);
  }
</style>
