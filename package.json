{
  "name": "mailflow-architecture-hub",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build:astro": "astro build",
    "index": "pagefind --site dist",
    "build": "bun run build:astro && bun run index",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "biome lint src scripts tests --files-ignore-unknown=true",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun test tests --path-ignore-patterns=tests/e2e/**",
    "test:unit": "bun test tests --path-ignore-patterns=tests/e2e/**",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "validate:privacy": "bun scripts/validateDist.ts dist",
    "validate:routes": "bun scripts/validateRoutes.ts dist",
    "validate:dist": "bun run validate:privacy && bun run validate:routes",
    "validate": "bun run check && bun run lint && bun run format:check && bun run test && bun run build && bun run validate:dist"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "astro": "^7.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.9",
    "@playwright/test": "1.62.1",
    "@types/bun": "1.3.14",
    "@types/node": "26.2.0",
    "pagefind": "1.5.2",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "5.9.3"
  }
}
